    { "id": "mali", "gap": 0.7, "tts": "Two Raakshasa brothers, Mali and Sumali, were great devotees of Shiva.", "caps": ["Two rakshasa brothers, | *Mali* and *Sumali*,", "were great devotees | of *Shiva*."], "y": 600 },
    { "id": "glow", "gap": 0.5, "caps": ["They prayed so hard, | they began to GLOW", "like the sun itself."], "y": 600 },
    { "id": "surya", "gap": 0.6, "caps": ["*Surya*, the sun god, | grew jealous."], "y": 1470 },
    { "id": "closer", "gap": 0.4, "caps": ["He came closer... | and closer...", "and burned them | to ASHES."], "y": 1470 },
    { "id": "fury", "gap": 0.7, "caps": ["*Shiva* was furious."], "y": 1380, "size": 64 },
    { "id": "hurl", "gap": 0.35, "caps": ["He hurled his *trishul* | at the sun."], "y": 1360 },
