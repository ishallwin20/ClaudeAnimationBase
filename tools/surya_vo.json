    { "id": "dark", "gap": 0.6, "caps": ["The world went DARK.", "Then cold.", "Rivers froze. | Flowers died."], "y": 600 },
    { "id": "curse1", "gap": 0.6, "caps": ["Surya's father, | *Kashyapa*, | cursed *Shiva*:"], "y": 1360 },
    { "id": "curse2", "gap": 0.3, "caps": ["\"One day, YOUR son | will lose his head!\""], "speaker": "rustom_en_suspense", "pace": 0.95, "y": 1360, "size": 64 },
    { "id": "ganesha", "gap": 0.7, "caps": ["That is why | *Ganesha* has an | elephant head."], "y": 1380 },
    { "id": "plea", "gap": 0.8, "caps": ["The world needed | a new sun.", "*Shiva* turned to | ONE goddess."], "y": 600 },
