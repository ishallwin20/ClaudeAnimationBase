  "lines": [
    { "id": "hook1", "t": 0.1, "caps": ["No creature with | TWO legs", "or FOUR legs | could kill him."], "y": 1180 },
    { "id": "hook2", "gap": 0.3, "caps": ["*Maa* *Durga's* | answer?", "SIX LEGS."], "y": 1180, "size": 66 },
    { "id": "tapas1", "gap": 0.7, "caps": ["The demon | *Arunasura*", "prayed to *Brahma* | for FORTY THOUSAND | years."], "y": 600 },
    { "id": "tapas2", "gap": 0.25, "caps": ["On leaves.", "Then water. | Then air.", "Then NOTHING."], "y": 600 },
    { "id": "boon", "gap": 0.5, "caps": ["*Brahma* granted it:", "no weapon,", "no two legs,", "no four legs."], "y": 1320 },
    { "id": "heaven", "gap": 0.6, "caps": ["He stormed HEAVEN", "and threw the | *gods* out."], "y": 560 },
    { "id": "shield1", "gap": 0.6, "caps": ["His shield was the | *Gayatri* mantra."], "y": 1360 },
    { "id": "shield2", "gap": 0.3, "caps": ["*Brihaspati* | tricked him", "into dropping it."], "y": 1360 },
    { "id": "pray", "gap": 0.6, "caps": ["The *gods* prayed | to the *Devi*."], "y": 600 },
    { "id": "abee", "gap": 1.8, "caps": ["\"A tiny | BEE?\""], "speaker": "rustom_en_suspense", "pace": 0.9, "fx": "asura", "y": 1380, "size": 72 },
    { "id": "count", "gap": 0.8, "caps": ["Count its legs."], "y": 1420 },
    { "id": "six", "gap": 2.3, "caps": ["SIX."], "y": 1420, "size": 96, "hold": 0.9 },
    { "id": "devi1", "gap": 1.1, "caps": ["\"Not two legs.", "Not four.\""], "speaker": "aditi_en_stories", "pace": 0.85, "fx": "devi", "y": 1380, "size": 64 },
    { "id": "devi2", "gap": 0.4, "caps": ["*Maa* *Durga* came | as *BHRAMARI*,", "the goddess | of bees."], "y": 1380 },
    { "id": "swarm1", "gap": 0.6, "caps": ["From her hands, | her hair:", "MILLIONS of bees."], "y": 560 },
    { "id": "swarm2", "gap": 0.4, "caps": ["No boon could | stop them."], "y": 560 },
    { "id": "gone1", "gap": 1.3, "caps": ["He feared every lion, | every elephant."], "y": 1300 },
    { "id": "gone2", "gap": 0.3, "caps": ["He never feared | a BEE."], "y": 1300, "size": 64 },
    { "id": "sri", "gap": 0.7, "caps": ["At *Srisailam*, | devotees say", "you can still HEAR | her bees."], "y": 600 },
    { "id": "ask", "gap": 0.6, "caps": ["Have you been to | *SRISAILAM* | or *KATEEL*?", "Comment your city!"], "y": 640, "hold": 1.2 }
